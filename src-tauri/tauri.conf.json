{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rewind",
  "version": "0.3.0",
  "identifier": "app.rewind.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Rewind",
        "width": 1180,
        "height": 760,
        "minWidth": 320,
        "minHeight": 380,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$VIDEO/**",
          "$HOME/**",
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Rewind",
    "shortDescription": "Local-only instant replay",
    "longDescription": "Rewind keeps the last few minutes of your screen in memory and saves clips on a hotkey. No account, no cloud, no telemetry.",
    "category": "Video",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ./windows/sign.ps1 %1",
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "startMenuFolder": "Rewind",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/installer-hooks.nsh",
        "template": "./windows/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBREFDRDQxNTFEQjM3Q0MKUldUTU45dFJRYzNhNmcxY0ZKR05ETm9IU096TmxZak9saVNUQUxwSE5UQzZpaDNneVFQUW1ON2YK",
      "endpoints": [
        "https://github.com/maksimtaimins-ai/Rewind/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}